      		].join(',');
      
      		const defaultText = "\u0986\u09ae\u09bf \u098f\u0987 \u09aa\u09cd\u09b0\u09cb\u09a1\u09be\u0995\u09cd\u099f\u099f\u09bf \u0995\u09bf\u09a8\u09a4\u09c7 \u099a\u09be\u099a\u09cd\u099b\u09bf";
      
      		function normalizePhone(raw) {
      			return String(raw || '').replace(/\D+/g, '');
      		}
      
      		function getProductTitle() {
      			const titleEl = document.querySelector(
      				'.product_title, h1.product_title, h1.entry-title, .single-product h1, .woocommerce-products-header__title'
      			);
      
      			if (titleEl && titleEl.textContent) {
      				const title = titleEl.textContent.trim();
      				if (title) {
      					return title;
      				}
      			}
      
      			return String(document.title || '').replace(/\s*[|•–-]\s*.*$/, '').trim();
      		}
      
      		function extractPhoneFromUrl(href) {
      			if (!href) {
      				return '';
      			}
      
      			try {
      				const url = new URL(href, window.location.href);
      				const host = url.hostname.toLowerCase();
      
      				if (host.indexOf('wa.me') !== -1) {
      					return normalizePhone(url.pathname);
      				}
      
      				const phone = url.searchParams.get('phone');
      				if (phone) {
      					return normalizePhone(phone);
      				}
      			} catch (error) {
      				return '';
      			}
      
      			return '';
      		}
      
      		function buildMessage(el) {
      			const customText = (
      				el.getAttribute('data-borbila-whatsapp-text') ||
      				el.getAttribute('data-whatsapp-text') ||
      				defaultText
      			).trim();
      
      			const productTitle = getProductTitle();
      			const parts = [];
      
      			if (customText) {
      				parts.push(customText);
      			}
      
      			if (productTitle) {
      				parts.push(productTitle);
      			}
      
      			return parts.join('\n');
      		}
      
      		function buildWhatsAppUrl(el) {
      			let phone = normalizePhone(
      				el.getAttribute('data-borbila-whatsapp-phone') ||
      				el.getAttribute('data-whatsapp-phone') ||
      				''
      			);
      
      			if (!phone && el.tagName === 'A') {
      				phone = extractPhoneFromUrl(el.getAttribute('href') || '');
      			}
      
      			if (!phone) {
      				return '';
      			}
      
      			const message = buildMessage(el);
      			return 'https://wa.me/' + encodeURIComponent(phone) + '?text=' + encodeURIComponent(message);
      		}
      
      		document.addEventListener('click', function(event) {
      			const el = event.target && event.target.closest ? event.target.closest(connectorSelector) : null;
      			if (!el) {
      				return;
      			}
      
      			const url = buildWhatsAppUrl(el);
      			if (!url) {
      				return;
      			}
      
      			event.preventDefault();
      			window.open(url, '_blank', 'noopener,noreferrer');
      		}, true);
      	})();
    </script>
