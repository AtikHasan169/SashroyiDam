# ==============================================================================
# সাশ্রয়ী দাম (Sashroyi Daam) — Environment Configuration Template (.env.example)
# Copy this file to .env or set these environment variables in your deployment
# (e.g., Google Cloud Run, Vercel, Render, Railway, or Docker container).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SESSION AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# A secure random string used to sign JWT auth tokens for customer & admin logins.
AUTH_SECRET=sashroyi_daam_production_auth_secret_key_2026_xyz

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE PERSISTENCE
# ------------------------------------------------------------------------------
# Required for persistent e-commerce data (orders, inventory, products, users)
# across server restarts and cloud container deployments.
# Get these from your Supabase Dashboard: Project Settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_api_key_here

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMIN STORE CREDENTIALS
# ------------------------------------------------------------------------------
# Initial store owner login credentials created on first boot if no admin exists.
SUPER_ADMIN_EMAIL=admin@sashroyidaam.com
SUPER_ADMIN_PASSWORD=OsheshAdmin2026!

# Alternative aliases:
ADMIN_EMAIL=admin@sashroyidaam.com
ADMIN_PASSWORD=OsheshAdmin2026!

# ------------------------------------------------------------------------------
# 5. SSLCOMMERZ BANGLADESH PAYMENT GATEWAY (Optional)
# ------------------------------------------------------------------------------
# Cash On Delivery (COD) works out-of-the-box without these.
# Fill these in when enabling bKash, Nagad, Rocket, and cards via SSLCommerz.
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_store_password

# ------------------------------------------------------------------------------
# 6. GEMINI API (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=nn